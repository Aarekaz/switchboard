{
  "name": "@aarekaz/switchboard-core",
  "version": "0.3.5",
  "description": "Core types, Bot client, and PlatformAdapter interface for Switchboard — the universal TypeScript SDK for chat bots.",
  "keywords": [
    "switchboard",
    "chat",
    "chatbot",
    "bot",
    "sdk",
    "core",
    "typescript",
    "multi-platform",
    "cross-platform",
    "ai",
    "agent",
    "streaming"
  ],
  "homepage": "https://github.com/Aarekaz/switchboard#readme",
  "bugs": {
    "url": "https://github.com/Aarekaz/switchboard/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aarekaz/switchboard.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "author": "Anurag Dhungana",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
