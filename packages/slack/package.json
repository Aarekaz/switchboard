{
  "name": "@aarekaz/switchboard-slack",
  "version": "0.3.5",
  "description": "Slack adapter for Switchboard — build cross-platform Slack bots with the same API as Discord and Telegram. Built on @slack/bolt v4.",
  "keywords": [
    "switchboard",
    "slack",
    "slack-bot",
    "slack-bolt",
    "bolt",
    "chat",
    "chatbot",
    "bot",
    "sdk",
    "adapter",
    "typescript"
  ],
  "homepage": "https://github.com/Aarekaz/switchboard#readme",
  "bugs": {
    "url": "https://github.com/Aarekaz/switchboard/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aarekaz/switchboard.git",
    "directory": "packages/slack"
  },
  "license": "MIT",
  "author": "Anurag Dhungana",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aarekaz/switchboard-core": "workspace:*",
    "@slack/bolt": "^4.6.0",
    "lru-cache": "^11.2.4"
  },
  "devDependencies": {
    "@types/node": "^25.0.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
